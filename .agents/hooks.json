{
  "antigravity-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File antigravity-guard.ps1",
            "timeout": 20
          }
        ]
      }
    ]
  }
}