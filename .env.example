# Threads API
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_USER_ID=
THREADS_USERNAME=
THREADS_LONG_LIVED_TOKEN=

# LLM provider — choose: claude | groq
LLM_PROVIDER=claude

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Behavior limits
MAX_REPLIES_PER_DAY=80
MAX_REPLIES_PER_HOUR=15
QUIET_HOURS_START=3
QUIET_HOURS_END=7

# Dry run: true = log only, false = actually post replies
DRY_RUN=true

# Webhook
WEBHOOK_VERIFY_TOKEN=
WEBHOOK_PORT=8000

# Feature #2 keyword search
KEYWORDS_TO_SEARCH=
SEARCH_RESULTS_PER_KEYWORD=10
MIN_DRAFT_SCORE=0.5
