# Threads API
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_USER_ID=
THREADS_USERNAME=
THREADS_LONG_LIVED_TOKEN=

# LLM provider — choose: claude | groq
LLM_PROVIDER=claude

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Behavior limits
MAX_REPLIES_PER_DAY=80
MAX_REPLIES_PER_HOUR=15
QUIET_HOURS_START=3
QUIET_HOURS_END=7

# Dry run: true = log only, false = actually post replies
DRY_RUN=true

# Webhook
WEBHOOK_VERIFY_TOKEN=
WEBHOOK_PORT=8000

# Feature #2 keyword search
# 關鍵字改在根目錄 keywords.txt 編輯（一行一個、# 註解、不限數量）
# 下方 KEYWORDS_TO_SEARCH 是 fallback——keywords.txt 存在時會被忽略
# KEYWORDS_TO_SEARCH=記帳,斷捨離,預算
SEARCH_RESULTS_PER_KEYWORD=10
MIN_DRAFT_SCORE=0.5

# Token 自動 refresh（src/token_refresher.py 管理）
# REFRESHED_AT 由程式自動寫入；THRESHOLD_DAYS 預設 30 天
THREADS_TOKEN_REFRESHED_AT=
THREADS_TOKEN_REFRESH_THRESHOLD_DAYS=30

# Telegram 通知（可選，留空則只用 console + log）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OAuth L2 (oauth_login.py) cert 取得策略 — 三選一：
#   self_signed   : 永遠用自簽 cert，瀏覽器首次跳「不安全」按進階→繼續 (lite 用戶推薦)
#   mkcert_auto   : 自動下載 mkcert (~5MB) + 跳 1 次 UAC 裝 CA → 之後零警告 (工程師推薦)
#   mkcert_manual : 你自己 choco install mkcert，沒裝 fallback 自簽
# Template 預設 self_signed，避免 lite 用戶看到 UAC 嚇到。改 mkcert_auto 體驗最好
CERT_MODE=self_signed
